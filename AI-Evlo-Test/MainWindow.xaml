<Window
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:AI_Evlo_Test"
xmlns:Objects="clr-namespace:AI_Evlo_Test.Objects" x:Name="windowEnvirnoment" x:Class="AI_Evlo_Test.MainWindow"
mc:Ignorable="d"
Title="Evlolutionary Neuro Nets" Height="627" Width="1201.6" MinWidth="900" MinHeight="480" Closing="windowEnvirnoment_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="BrushBorder" Color="#FFCAD4F3"/>
    </Window.Resources>
    <Grid x:Name="gridMain" Margin="0,0,0,0" UseLayoutRounding="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="282" MaxHeight="270" MinHeight="265"/>
            <RowDefinition/>
            <RowDefinition Height="100" MaxHeight="101" MinHeight="99"/>
            <RowDefinition MaxHeight="24" Height="18.4"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="907*"/>
            <ColumnDefinition Width="295*"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="lblStatusBar" Content="" HorizontalAlignment="Left" Margin="0,0,0,3" Width="1184" Height="24" VerticalAlignment="Bottom"   Grid.Row="2" MaxHeight="24" VerticalContentAlignment="Bottom" Padding="3,3,1,1" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <Canvas x:Name="panlUniverseView" Margin="289,0,0,9" Background="#FF171B31" Loaded="PanlUniverseView_Loaded" Grid.RowSpan="3" SizeChanged="panlUniverseView_SizeChanged" Grid.ColumnSpan="2" />
        <TextBox x:Name="txtLog" Height="90.8" Margin="293,0,0,9" TextWrapping="Wrap" Text="Nothing yet" UseLayoutRounding="False" VerticalContentAlignment="Bottom" HorizontalScrollBarVisibility="Auto" VerticalAlignment="Bottom" VerticalScrollBarVisibility="Auto" BorderBrush="#FF042E27" TextChanged="TxtLog_TextChanged" Background="{x:Null}" Foreground="#FF57C3AF" RenderTransformOrigin="0.5,0.5" IsReadOnly="True" Grid.Row="2" Grid.ColumnSpan="2"/>
        <GroupBox x:Name="groupBoxSelectedAgent" Panel.ZIndex="5" Header="Selected Agent" HorizontalAlignment="Left" BorderBrush="#FF89969E" Background="#FFE1E8F5" Margin="0,0,0,4" Grid.Row="1" MaxWidth="284" Height="172" VerticalAlignment="Bottom" Width="284">
            <GroupBox.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </GroupBox.Effect>
            <StackPanel Margin="2,0,2,0">
                <!-- Header: species icon + title/subtitle -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="5" Background="#FF1F243A" Margin="0,0,7,0">
                        <Image x:Name="imgSelectedSpecies" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="lblSelectedTitle" FontWeight="Bold" FontSize="12" Text="No agent selected"/>
                        <TextBlock x:Name="lblSelectedSub" FontSize="10" Foreground="#FF5A6472" Text="click an agent to inspect it"/>
                    </StackPanel>
                </StackPanel>

                <!-- HP bar -->
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="66"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HP" FontSize="10" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="pbSelectedHP" Grid.Column="1" Height="13" Minimum="0" Maximum="100" Value="0" Foreground="#FF4CAF50" Background="#FFDCE0E6" BorderBrush="#FFBFC6CF"/>
                    <TextBlock x:Name="lblSelectedHP" Grid.Column="2" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" Text=""/>
                </Grid>

                <!-- Brain (neural-net) visualization -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="&#x1F9E0;" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Border Background="#1A102040" CornerRadius="3" Padding="3,1,3,1" VerticalAlignment="Center">
                        <StackPanel x:Name="pnlBrainLayers" Orientation="Horizontal" Height="18" VerticalAlignment="Bottom"/>
                    </Border>
                    <TextBlock x:Name="lblBrainInfo" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#FF3A4452" Text=""/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="btnDeleteObject" Content="Delete" Width="43" Click="BtnDeleteObject_Click" ToolTip="Delete selected agent" Padding="1" Height="20" Margin="0,0,5,0"/>
                    <Button x:Name="btnMutateSelected" Content="Mutate NN" Click="btnMutate_Click_1" ToolTip="Mutate neural network of the selected object" HorizontalContentAlignment="Center" Width="68" Height="20" Margin="0,0,5,0"/>
                    <Button x:Name="btnVisualNet" Content="Show Net" Click="BtnVisualNet_Click_1" Width="61" ToolTip="Show map of the neural network" Height="20" Margin="0,0,5,0"/>
                    <Button x:Name="btnStopTargets" Content="Anchor rafts" Width="80" Click="Button_Click" Height="20"  Margin="0,0,5,0" ToolTip="Anchor or release the rafts"/>
                </StackPanel>
            </StackPanel>

        </GroupBox>

        <GroupBox x:Name="groupBoxPopulation" Header="Populations" HorizontalAlignment="Left" Width="284" Height="181" VerticalAlignment="Top" BorderBrush="#FF89969E" Background="#FFEEEEEE" Margin="0,82,0,0">
            <GroupBox.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </GroupBox.Effect>
            <!-- Editor laid out in real Grid rows/columns (was fragile absolute margins). -->
            <Grid Margin="4,2,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0 background strip tinted with the selected population's colour -->
                <Rectangle x:Name="rectanglePopulationColor" Grid.Row="0" Grid.ColumnSpan="4"
                           Fill="#FFEDEDED" Stroke="#FFD8D6D6" RadiusX="5" RadiusY="5" Opacity="0.65" Margin="0,2,0,2">
                    <Rectangle.Effect>
                        <DropShadowEffect Opacity="0.2"/>
                    </Rectangle.Effect>
                </Rectangle>

                <!-- Row 0: Name + Size -->
                <Label x:Name="lblPopulationName" Grid.Row="0" Grid.Column="0" Content="Name" VerticalAlignment="Center" Padding="3,0,3,0"/>
                <ComboBox x:Name="ddlPopulationName" Grid.Row="0" Grid.Column="1" Margin="0,4,6,4"
                          VerticalAlignment="Center" Height="24" IsEditable="True" Opacity="0.85"
                          ItemsSource="{Binding lsPopulations}" DisplayMemberPath="Name" SelectedValuePath="ID"
                          SelectedValue="{Binding SelectedPopulation}" SelectionChanged="DdlPopulationName_SelectionChanged"
                          ToolTip="Population name. Quite optional"/>
                <Label x:Name="lblSizePopulation" Grid.Row="0" Grid.Column="2" Content="Size" VerticalAlignment="Center" Padding="3,0,3,0" ToolTip="Population size: max number of agents"/>
                <TextBox x:Name="txtPopulationSize" Grid.Row="0" Grid.Column="3" Margin="0,4,2,4" Width="40" Height="22"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" Text="100"
                         Opacity="0.85"
                         ToolTip="Number of agents in the population"/>

                <!-- Row 1: Brain + Being -->
                <Label x:Name="lblSizePopulation_Copy" Grid.Row="1" Grid.Column="0" Content="Brain" VerticalAlignment="Center" Padding="3,0,3,0"/>
                <ComboBox x:Name="ddlPopulationNeuroNetType" Grid.Row="1" Grid.Column="1" Margin="0,4,6,4"
                          HorizontalAlignment="Left" Width="92" VerticalAlignment="Center" ToolTip="Size of the neural network">
                    <ListBoxItem Content="Small" IsSelected="True"/>
                    <ListBoxItem Content="Medium"/>
                    <ListBoxItem Content="Large"/>
                </ComboBox>
                <Label x:Name="lblPopulationBeing" Grid.Row="1" Grid.Column="2" Content="Being" VerticalAlignment="Center" Padding="3,0,3,0"/>
                <ComboBox x:Name="ddlPopulationBeing" Grid.Row="1" Grid.Column="3" Margin="0,4,2,4"
                          Width="72" VerticalAlignment="Center" ToolTip="Type of the evolving being">
                    <ComboBoxItem Content="Frogs" IsSelected="True"/>
                    <ComboBoxItem Content="Birds"/>
                    <ComboBoxItem Content="Sharks"/>
                </ComboBox>

                <!-- Row 2: action buttons -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="2,4,0,2">
                    <Button x:Name="btnPopulationUpdate" Content="Update" Width="74" Height="22" Margin="0,0,8,0"
                            Click="BtnPopulationUpdate_Click" IsEnabled="False" ToolTip="Update selected population"/>
                    <Button x:Name="btnNewObject" Content="Create New" Width="81" Height="22"
                            Click="BtnNewPopulation_Click" ToolTip="Create new population of agents"/>
                </StackPanel>

                <!-- Row 3: live population info -->
                <Label x:Name="lblPopulationInfo" Grid.Row="3" Grid.ColumnSpan="4" Content="Population:" Padding="2,2,3,2" VerticalAlignment="Top"/>

                <!-- Row 4: population behavior settings -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="5,2,0,0">
                    <CheckBox x:Name="chkPopulationSpawnDelay"
                              Content="Spawn Delay" Margin="0,0,12,0" VerticalAlignment="Center"
                              Checked="ChkPopulationSpawnDelay_Changed" Unchecked="ChkPopulationSpawnDelay_Changed"
                              ToolTip="When enabled, this population uses delayed respawn. When disabled, it respawns one agent every tick while below its size limit."/>
                    <CheckBox x:Name="chkPopulationPauseMutation"
                              Content="Pause Mutation" VerticalAlignment="Center"
                              Checked="ChkPopulationPauseMutation_Changed" Unchecked="ChkPopulationPauseMutation_Changed"
                              ToolTip="When enabled, copied regrowth brains are not mutated for this population."/>
                </StackPanel>
            </Grid>
        </GroupBox>


        <Button x:Name="btnStart" Content="&#x25B6; Start" FontFamily="Segoe UI Symbol" Foreground="White" Background="#FF4CAF50" Height="20" Margin="225,50,0,0" VerticalAlignment="Top" Click="BtnStart_Click" HorizontalAlignment="Left" Width="64" ToolTip="Start/Pause experiment"/>

        <Label Content="Speed" HorizontalAlignment="Left" Margin="5,47,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.427,0.523" Height="26" Width="43"/>
        <Slider x:Name="sliderSpeed" HorizontalAlignment="Left" Margin="54,46,0,0" VerticalAlignment="Top" Width="166" Minimum="0" Maximum="100" SmallChange="1" TickFrequency="10" TickPlacement="TopLeft" Value="90" ValueChanged="SliderSpeed_ValueChanged" RenderTransformOrigin="0.5,0.5" Height="23" ToolTip="Simulation speed — left = slow, right = fast"/>
        <Button x:Name="btnClear" Content="Clear Log" Margin="0,0,35,70" Click="BtnClear_Click" HorizontalAlignment="Right" Width="71" Height="20" VerticalAlignment="Bottom" Background="{x:Null}" Foreground="#FF52934F" BorderBrush="#FF224426" Grid.Row="2" Grid.Column="1"/>


        <ComboBox x:Name="ddlEnvirnoment" HorizontalAlignment="Left" 
    Margin="92,12,0,0" VerticalAlignment="Top" Width="156" SelectionChanged="DdlEnvirnoment_SelectionChanged" Height="22">
            <ComboBoxItem Content="Food is moving"/>
            <ComboBoxItem Content="One raft can't take them all" IsSelected="True"/>
        </ComboBox>
        <Label x:Name="lblEnvirnomet" Content="Environment" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.152,-0.705" ToolTip="Select environment" Height="26" Width="77"/>
        <Image x:Name="imgHelp" HorizontalAlignment="Left" Margin="253,12,0,0" VerticalAlignment="Top" Width="21" Source="img/Help-icon.png" MouseLeftButtonUp="ImgHelp_MouseLeftButtonUp" Height="21"/>
        <ScrollViewer x:Name="ScrollPopulations" HorizontalAlignment="Left" Margin="0,3,0,180" Grid.Row="1" Width="284" Padding="0,3,0,1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StackPnlPopulations" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </ScrollViewer>
        <Button x:Name="btnMovementSettings" Content="Sim Parameters" HorizontalAlignment="Left" Margin="5,0,0,0" Grid.Row="2" VerticalAlignment="Center" Width="108" Height="22" Click="BtnMovementSettings_Click" ToolTip="Configure simulation parameters"/>
        <CheckBox x:Name="chkHeadless" Content="Headless" HorizontalAlignment="Left" Margin="205,0,0,0" Grid.Row="2" VerticalAlignment="Center" Checked="ChkHeadless_Changed" Unchecked="ChkHeadless_Changed" ToolTip="Skip rendering for faster training"/>

        <!-- On-canvas legend / key. Non-interactive so clicks pass through to agents. -->
        <Border x:Name="legendKey" Panel.ZIndex="20" IsHitTestVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                Margin="0,8,14,0" Padding="9,6,11,7" CornerRadius="6"
                Background="#CC121733" BorderBrush="#40FFFFFF" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Key" Foreground="#FFB9C4EC" FontWeight="Bold" FontSize="11" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
                    <Ellipse Width="12" Height="12" Fill="Gold" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Gold" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="Golden agent (averaged brain)" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
                    <Ellipse Width="12" Height="12" Fill="#FF4488DD" Opacity="0.3" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Faded = low health" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
                    <Ellipse Width="12" Height="12" Fill="#FF4488DD" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Color = its population" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <Ellipse Width="12" Height="12" Fill="#FF3A4570" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Raft sinks when crowded" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Live sparkline beside the status bar: agents alive (green) + top fitness (gold). -->
        <Border x:Name="sparklinePanel" Grid.Row="2" Grid.RowSpan="2" Grid.Column="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="30"
                Margin="0,0,8,1" Padding="6,2,6,2" CornerRadius="4"
                Background="#CC121733" BorderBrush="#40FFFFFF" BorderThickness="1"
                ToolTip="Live history — agents alive (green), top fitness (gold)">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="alive" Foreground="#FF6FCF8E" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <TextBlock Text="fit" Foreground="Gold" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Canvas x:Name="sparkCanvas" Width="120" Height="22" ClipToBounds="True">
                    <Polyline x:Name="sparkAlive" Stroke="#FF6FCF8E" StrokeThickness="1.2"/>
                    <Polyline x:Name="sparkFitness" Stroke="Gold" StrokeThickness="1.2"/>
                </Canvas>
            </StackPanel>
        </Border>
    </Grid>
</Window>
