<Window
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:AI_Evlo_Test"
xmlns:Objects="clr-namespace:AI_Evlo_Test.Objects" x:Name="windowEnvirnoment" x:Class="AI_Evlo_Test.MainWindow"
mc:Ignorable="d"
Title="Evlolutionary Neuro Nets" Height="627" Width="1201.6" SizeToContent="Width" MouseMove="WindowEnvirnoment_MouseMove" Closing="windowEnvirnoment_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="BrushBorder" Color="#FFCAD4F3"/>
    </Window.Resources>
    <Grid x:Name="gridMain" Margin="0,0,0,0" UseLayoutRounding="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="282" MaxHeight="270" MinHeight="265"/>
            <RowDefinition/>
            <RowDefinition Height="100" MaxHeight="101" MinHeight="99"/>
            <RowDefinition MaxHeight="24" Height="18.4"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="907*"/>
            <ColumnDefinition Width="295*"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="lblStatusBar" Content="" HorizontalAlignment="Left" Margin="0,0,0,3" Width="1184" Height="24" VerticalAlignment="Bottom"   Grid.Row="2" MaxHeight="24" VerticalContentAlignment="Bottom" Padding="3,3,1,1" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <Canvas x:Name="panlUniverseView" Margin="289,0,0,9" Background="#FF171B31" Loaded="PanlUniverseView_Loaded" Grid.RowSpan="3" SizeChanged="panlUniverseView_SizeChanged" Grid.ColumnSpan="2" />
        <TextBox x:Name="txtLog" Height="90.8" Margin="293,0,0,9" TextWrapping="Wrap" Text="Nothing yet" UseLayoutRounding="False" VerticalContentAlignment="Bottom" HorizontalScrollBarVisibility="Auto" VerticalAlignment="Bottom" VerticalScrollBarVisibility="Auto" BorderBrush="#FF042E27" TextChanged="TxtLog_TextChanged" Background="{x:Null}" Foreground="#FF57C3AF" RenderTransformOrigin="0.5,0.5" IsReadOnly="True" Grid.Row="2" Grid.ColumnSpan="2"/>
        <GroupBox x:Name="groupBoxSelectedAgent" Header="Selected Agent" HorizontalAlignment="Left" BorderBrush="#FF89969E" Background="#FFE1E8F5" Margin="0,0,0,10" Grid.Row="1" MaxWidth="280" Grid.RowSpan="2" Height="96" VerticalAlignment="Bottom" Width="284">
            <GroupBox.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </GroupBox.Effect>
            <StackPanel>
                <Label x:Name="lblID" HorizontalAlignment="Left" Margin="0" RenderTransformOrigin="-1.24,-0.227" Width="273" Height="45" Grid.Row="1" Padding="1,0,0,1">
                </Label>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button x:Name="btnDeleteObject" Content="Delete" Width="43" Click="BtnDeleteObject_Click" ToolTip="Delete selected agent" Padding="1" Height="20" Margin="0,0,5,0"/>
                    <Button x:Name="btnMutateSelected" Content="Mutate NN" Click="btnMutate_Click_1" ToolTip="Mutate neural network of the selected object" HorizontalContentAlignment="Center" Width="68" Height="20" Margin="0,0,5,0"/>
                    <Button x:Name="btnVisualNet" Content="Show Net" Click="BtnVisualNet_Click_1" Width="61" ToolTip="Show map of the neural network" Height="20" Margin="0,0,5,0"/>
                    <Button x:Name="btnStopTargets" Content="Anchor rafts" Width="80" Click="Button_Click" Height="20"  Margin="0,0,5,0" ToolTip="Anchor or release the rafts"/>
                </StackPanel>
            </StackPanel>

        </GroupBox>

        <GroupBox x:Name="groupBoxPopulation" Header="Populations" HorizontalAlignment="Left" Width="284" Height="181" VerticalAlignment="Top" BorderBrush="#FF89969E" Background="#FFEEEEEE" Margin="0,82,0,0">
            <GroupBox.Effect>
                <DropShadowEffect Opacity="0.2"/>
            </GroupBox.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="269*"/>
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="rectanglePopulationColor" Fill="#FFEDEDED" HorizontalAlignment="Left" Height="35" Margin="1,5,0,0" Stroke="#FFD8D6D6" VerticalAlignment="Top" Width="270" RadiusX="5" RadiusY="5" Opacity="0.65" Grid.ColumnSpan="2">
                    <Rectangle.Effect>
                        <DropShadowEffect Opacity="0.2"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Label x:Name="lblPopulationName" Content="Name" HorizontalAlignment="Left" Margin="0.8,8,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.152,-0.705" Height="26" Grid.Column="1"/>
                <ComboBox x:Name="ddlPopulationName" HorizontalAlignment="Left" Margin="46.8,10,0,0" 
                    VerticalAlignment="Top" Width="134" IsEditable="True" 
                    ItemsSource="{Binding lsPopulations}" DisplayMemberPath="Name" SelectedValuePath="ID"  
                    SelectedValue="{Binding SelectedPopulation}" SelectionChanged="DdlPopulationName_SelectionChanged" Height="24" Opacity="0.85" ToolTip="Population name. Quite optional" Grid.Column="1" />
                <Label x:Name="lblSizePopulation" Content="Size" HorizontalAlignment="Left" Margin="185.8,8,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.152,-0.705" Height="26" ToolTip="Population size: Max numebrs of agents" Grid.Column="1"/>
                <TextBox x:Name="txtPopulationSize" Height="22" Margin="220.8,8,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="100" TextChanged="TxtCreateObjectsNumber_TextChanged" RenderTransformOrigin="-0.69,0.682" HorizontalAlignment="Left" Width="38" UseLayoutRounding="True" Opacity="0.85" ToolTip="Number of agents in the population" Grid.Column="1"/>
                <Label x:Name="lblSizePopulation_Copy" Content="Brain" HorizontalAlignment="Left" Margin="2.8,50,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.152,-0.705" Grid.Column="1"/>
                <ComboBox x:Name="ddlPopulationNeuroNetType" HorizontalAlignment="Left" 
            Margin="50.8,50,0,0" VerticalAlignment="Top" Width="92" ToolTip="Size of the neural network" Grid.Column="1">
                    <ListBoxItem Content="Small" IsSelected="True"/>
                    <ListBoxItem Content="Medium"/>
                    <ListBoxItem Content="Large"/>
                </ComboBox>
                <Label x:Name="lblPopulationBeing" Content="Being" HorizontalAlignment="Left" Margin="148.8,50,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.152,-0.705" Grid.Column="1"/>
                <ComboBox x:Name="ddlPopulationBeing" HorizontalAlignment="Left" Margin="190.8,50,0,0" VerticalAlignment="Top" Width="72" ToolTip="Type of the evolving being" Grid.Column="1">
                    <ComboBoxItem Content="Frogs" IsSelected="True"/>
                    <ComboBoxItem Content="Birds"/>
                    <ComboBoxItem Content="Sharks"/>
                </ComboBox>
                <Button x:Name="btnPopulationUpdate" Content="Update" HorizontalAlignment="Left" Height="22" Margin="6.8,85,0,0" VerticalAlignment="Top" Width="74" Click="BtnPopulationUpdate_Click" IsEnabled="False" ToolTip="Update selected population" Grid.Column="1"/>
                <Button x:Name="btnNewObject" Content="Create New" HorizontalAlignment="Left" Height="22" Margin="90.8,85,0,0" VerticalAlignment="Top" Width="81" Click="BtnNewPopulation_Click" ToolTip="Create new population of agents" Grid.Column="1"/>
                <Label x:Name="lblPopulationInfo" Content="Population:" Margin="0,110,-8,0" VerticalAlignment="Top" RenderTransformOrigin="-1.24,-0.227" Height="48" Width="280" Padding="2,2,3,2" Grid.ColumnSpan="2"/>
            </Grid>
        </GroupBox>


        <Button x:Name="btnStart" Content="Start" Height="20" Margin="225,50,0,0" VerticalAlignment="Top" Click="BtnStart_Click" HorizontalAlignment="Left" Width="52" ToolTip="Start/Pause experiment"/>

        <Label Content="Speed" HorizontalAlignment="Left" Margin="5,47,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.427,0.523" Height="26" Width="43"/>
        <Slider x:Name="sliderSpeed" HorizontalAlignment="Left" Margin="54,46,0,0" VerticalAlignment="Top" Width="166" Maximum="98" SmallChange="0" TickFrequency="10" TickPlacement="TopLeft" Value="10" ValueChanged="SliderSpeed_ValueChanged" RenderTransformOrigin="0.5,0.5" Height="23"/>
        <Button x:Name="btnClear" Content="Clear Log" Margin="0,0,35,70" Click="BtnClear_Click" HorizontalAlignment="Right" Width="71" Height="20" VerticalAlignment="Bottom" Background="{x:Null}" Foreground="#FF52934F" BorderBrush="#FF224426" Grid.Row="2" Grid.Column="1"/>


        <ComboBox x:Name="ddlEnvirnoment" HorizontalAlignment="Left" 
    Margin="92,12,0,0" VerticalAlignment="Top" Width="156" SelectionChanged="DdlEnvirnoment_SelectionChanged" Height="22">
            <ComboBoxItem Content="Food is moving"/>
            <ComboBoxItem Content="One raft can't take them all" IsSelected="True"/>
        </ComboBox>
        <Label x:Name="lblEnvirnomet" Content="Environment" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.152,-0.705" ToolTip="Select environment" Height="26" Width="77"/>
        <Image x:Name="imgHelp" HorizontalAlignment="Left" Margin="253,12,0,0" VerticalAlignment="Top" Width="21" Source="img/Help-icon.png" MouseLeftButtonUp="ImgHelp_MouseLeftButtonUp" Height="21"/>
        <ScrollViewer x:Name="ScrollPopulations" HorizontalAlignment="Left" Margin="0,3,0,10" Grid.Row="1" Width="284" Padding="0,3,0,1">
            <StackPanel x:Name="StackPnlPopulations" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        </ScrollViewer>
        <CheckBox x:Name="chkHeadless" Content="Headless" HorizontalAlignment="Left" Margin="205,0,0,0" Grid.Row="2" VerticalAlignment="Center" Checked="ChkHeadless_Changed" Unchecked="ChkHeadless_Changed" ToolTip="Skip rendering for faster training"/>
    </Grid>
</Window>
