<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="windowEnvirnoment" x:Class="AI_Evlo_Test.MainWindow" Title="AI-Evlo — Evolutionary Ecosystem" Width="1280" Height="800" MinWidth="900" MinHeight="600" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" Closing="windowEnvirnoment_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="BrushBorder" Color="#CAD4F3" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="6" />
    </Style>
  </Window.Resources>
  <Grid x:Name="gridMain" Margin="10" Background="#F4F6FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" CornerRadius="6" Padding="8" Margin="0,0,0,8">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <Button x:Name="btnStart" Content="▶ Start" Foreground="White" Background="#4CAF50" MinWidth="86" Margin="0,0,12,4" Click="BtnStart_Click" ToolTip="Start or pause (Ctrl+Space)" />
          <TextBlock Text="Environment" VerticalAlignment="Center" Margin="0,0,6,4" />
          <ComboBox x:Name="ddlEnvirnoment" Width="186" Margin="0,0,12,4" VerticalContentAlignment="Center" SelectionChanged="DdlEnvirnoment_SelectionChanged">
            <ComboBoxItem Content="Food is moving" />
            <ComboBoxItem Content="One raft can't take them all" IsSelected="True" />
          </ComboBox>
          <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,4" />
          <Slider x:Name="sliderSpeed" Width="140" Minimum="0" Maximum="100" Value="90" SmallChange="1" TickFrequency="10" ValueChanged="SliderSpeed_ValueChanged" Margin="0,0,12,4" VerticalAlignment="Center" ToolTip="Left = slow; right = maximum throughput" />
          <CheckBox x:Name="chkHeadless" Content="Headless training" Margin="0,0,12,4" VerticalAlignment="Center" Checked="ChkHeadless_Changed" Unchecked="ChkHeadless_Changed" ToolTip="Skip world rendering" />
          <Button x:Name="btnMovementSettings" Content="Simulation parameters" Margin="0,0,12,4" Click="BtnMovementSettings_Click" />
          <Image x:Name="imgHelp" Source="img/Help-icon.png" Width="22" Height="22" Margin="0,0,0,4" MouseLeftButtonUp="ImgHelp_MouseLeftButtonUp" ToolTip="Ecosystem help" />
        </WrapPanel>
        <WrapPanel>
          <TextBlock Text="Starting scenarios" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Content="Save preset…" Click="SavePreset_Click" Margin="0,0,6,0" ToolTip="Save population settings and environment with fresh brains on load" />
          <Button Content="Load preset…" Click="LoadPreset_Click" Margin="0,0,6,0" />
          <TextBlock Text="Ctrl+D dashboard · Ctrl+B brain · Ctrl+M members" Foreground="#596579" VerticalAlignment="Center" Margin="6,0,0,0" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" MinWidth="300" MaxWidth="500" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Expander Name="populationEditor" Header="Population settings / Create new" IsExpanded="False" Margin="0,0,0,8" Expanded="PopulationEditor_Expanded">
          <GroupBox x:Name="groupBoxPopulation" Header="Populations" BorderBrush="#FF89969E" Background="#FFEEEEEE" Margin="0,0,0,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
            <GroupBox.Effect>
              <DropShadowEffect Opacity="0.2" />
            </GroupBox.Effect>
            <!-- Editor laid out in real Grid rows/columns (was fragile absolute margins). -->
            <Grid Margin="4,2,4,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <!-- Row 0 background strip tinted with the selected population's colour -->
              <Rectangle x:Name="rectanglePopulationColor" Grid.Row="0" Grid.ColumnSpan="4" Fill="#FFEDEDED" Stroke="#FFD8D6D6" RadiusX="5" RadiusY="5" Opacity="0.65" Margin="0,2,0,2">
                <Rectangle.Effect>
                  <DropShadowEffect Opacity="0.2" />
                </Rectangle.Effect>
              </Rectangle>
              <!-- Row 0: Name + Size -->
              <Label x:Name="lblPopulationName" Grid.Row="0" Grid.Column="0" Content="Name" VerticalAlignment="Center" Padding="3,0,3,0" />
              <ComboBox x:Name="ddlPopulationName" Grid.Row="0" Grid.Column="1" Margin="0,4,6,4" VerticalAlignment="Center" Height="24" IsEditable="True" Opacity="0.85" ItemsSource="{Binding lsPopulations}" DisplayMemberPath="Name" SelectedValuePath="ID" SelectedValue="{Binding SelectedPopulation}" SelectionChanged="DdlPopulationName_SelectionChanged" ToolTip="Population name. Quite optional" />
              <Label x:Name="lblSizePopulation" Grid.Row="0" Grid.Column="2" Content="Size" VerticalAlignment="Center" Padding="3,0,3,0" ToolTip="Population size: max number of agents" />
              <TextBox x:Name="txtPopulationSize" Grid.Row="0" Grid.Column="3" Margin="0,4,2,4" Width="40" Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="100" Opacity="0.85" ToolTip="Number of agents in the population" />
              <!-- Row 1: Brain + Being -->
              <Label x:Name="lblSizePopulation_Copy" Grid.Row="1" Grid.Column="0" Content="Brain" VerticalAlignment="Center" Padding="3,0,3,0" />
              <ComboBox x:Name="ddlPopulationNeuroNetType" Grid.Row="1" Grid.Column="1" Margin="0,4,6,4" HorizontalAlignment="Left" Width="92" VerticalAlignment="Center" ToolTip="Size of the neural network">
                <ListBoxItem Content="Small" IsSelected="True" />
                <ListBoxItem Content="Medium" />
                <ListBoxItem Content="Large" />
                <ListBoxItem x:Name="itemCustomBrain" Content="Custom" Visibility="Collapsed" />
              </ComboBox>
              <Label x:Name="lblPopulationBeing" Grid.Row="1" Grid.Column="2" Content="Being" VerticalAlignment="Center" Padding="3,0,3,0" />
              <ComboBox x:Name="ddlPopulationBeing" Grid.Row="1" Grid.Column="3" Margin="0,4,2,4" Width="72" VerticalAlignment="Center" ToolTip="Type of the evolving being">
                <ComboBoxItem Content="Frogs" IsSelected="True" />
                <ComboBoxItem Content="Birds" />
                <ComboBoxItem Content="Sharks" />
              </ComboBox>
              <!-- Row 2: action buttons -->
              <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="2,4,0,2">
                <Button x:Name="btnPopulationUpdate" Content="Update" Margin="0,0,8,0" Click="BtnPopulationUpdate_Click" IsEnabled="False" ToolTip="Update selected population" />
                <Button x:Name="btnNewObject" Content="Create New" Click="BtnNewPopulation_Click" ToolTip="Create new population of agents" />
              </StackPanel>
              <!-- Row 3: live population info -->
              <Label x:Name="lblPopulationInfo" Grid.Row="3" Grid.ColumnSpan="4" Content="Population:" Padding="2,2,3,2" VerticalAlignment="Top" FontSize="11">
                <Label.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </Label.ContentTemplate>
              </Label>
              <!-- Row 4: population behavior settings -->
              <WrapPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="5,2,0,0">
                <CheckBox x:Name="chkPopulationSpawnDelay" Content="Spawn Delay" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ChkPopulationSpawnDelay_Changed" Unchecked="ChkPopulationSpawnDelay_Changed" ToolTip="When enabled, this population uses delayed respawn. When disabled, it respawns one agent every tick while below its size limit." />
                <CheckBox x:Name="chkPopulationPauseMutation" Content="Pause Mutation" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ChkPopulationPauseMutation_Changed" Unchecked="ChkPopulationPauseMutation_Changed" ToolTip="When enabled, copied regrowth brains are not mutated for this population." />
                <CheckBox x:Name="chkPopulationAutoGrow" Content="Auto grow NN" VerticalAlignment="Center" Checked="ChkPopulationAutoGrow_Changed" Unchecked="ChkPopulationAutoGrow_Changed" ToolTip="Grow and protect this population's neural network when its survival record reaches the next doubling milestone." />
              </WrapPanel>
            </Grid>
          </GroupBox>
        </Expander>
        <TextBlock x:Name="populationValidation" Grid.Row="1" Foreground="#B42318" TextWrapping="Wrap" Margin="4,0,4,6" />
        <ScrollViewer x:Name="ScrollPopulations" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="StackPnlPopulations" />
        </ScrollViewer>
        <Expander Grid.Row="3" Header="Agent inspector" IsExpanded="True" Margin="0,8,0,0" Name="inspectorPanel">
          <GroupBox x:Name="groupBoxSelectedAgent" Panel.ZIndex="5" Header="Selected Agent" BorderBrush="#FF89969E" Background="#FFE1E8F5" Margin="0,4,0,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
            <GroupBox.Effect>
              <DropShadowEffect Opacity="0.2" />
            </GroupBox.Effect>
            <StackPanel Margin="2,0,2,0">
              <!-- Header: species icon + title/subtitle -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="5" Background="#FF1F243A" Margin="0,0,7,0">
                  <Image x:Name="imgSelectedSpecies" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel VerticalAlignment="Center" Grid.Column="1">
                  <TextBlock x:Name="lblSelectedTitle" FontWeight="Bold" FontSize="12" Text="No agent selected" />
                  <TextBlock x:Name="lblSelectedSub" FontSize="10" Foreground="#FF5A6472" Text="click an agent to inspect it" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <!-- HP bar -->
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HP" FontSize="10" VerticalAlignment="Center" />
                <ProgressBar x:Name="pbSelectedHP" Grid.Column="1" Height="13" Minimum="0" Maximum="100" Value="0" Foreground="#FF4CAF50" Background="#FFDCE0E6" BorderBrush="#FFBFC6CF" />
                <TextBlock x:Name="lblSelectedHP" Grid.Column="2" FontSize="10" VerticalAlignment="Center" Margin="5,0,0,0" Text="" />
              </Grid>
              <!-- Brain (neural-net) visualization -->
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="🧠" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Border Background="#1A102040" CornerRadius="3" Padding="3,1,3,1" VerticalAlignment="Center">
                  <StackPanel x:Name="pnlBrainLayers" Orientation="Horizontal" Height="18" VerticalAlignment="Bottom" />
                </Border>
                <TextBlock x:Name="lblBrainInfo" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#FF3A4452" Text="" />
              </StackPanel>
              <!-- Action buttons -->
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="btnDeleteObject" Content="Delete" Click="BtnDeleteObject_Click" ToolTip="Delete selected agent" Padding="1" Margin="0,0,5,0" />
                <Button x:Name="btnStopTargets" Content="Anchor rafts" Click="Button_Click" Margin="0,0,5,0" ToolTip="Anchor or release the rafts" />
              </StackPanel>
            </StackPanel>
          </GroupBox>
        </Expander>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#CAD4F3" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ClipToBounds="True">
          <Canvas x:Name="panlUniverseView" Background="#171B31" Loaded="PanlUniverseView_Loaded" SizeChanged="panlUniverseView_SizeChanged" />
          <Border x:Name="legendKey" Panel.ZIndex="20" IsHitTestVisible="False" Padding="9,6,11,7" CornerRadius="6" Background="#CC121733" BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
            <StackPanel>
              <TextBlock Text="Key" Foreground="#FFB9C4EC" FontWeight="Bold" FontSize="11" Margin="0,0,0,5" />
              <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
                <Ellipse Width="12" Height="12" Fill="Gold" Margin="0,0,7,0" VerticalAlignment="Center">
                  <Ellipse.Effect>
                    <DropShadowEffect Color="Gold" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                  </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="Golden agent (averaged brain)" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
                <Ellipse Width="12" Height="12" Fill="#FF4488DD" Opacity="0.3" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Faded = low health" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
                <Ellipse Width="12" Height="12" Fill="#FF4488DD" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Color = its population" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                <Ellipse Width="12" Height="12" Fill="#FF3A4570" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="Raft sinks when crowded" Foreground="#FFDCE2F4" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <Expander Grid.Row="1" Header="Activity log" IsExpanded="False" Margin="0,8,0,0">
          <DockPanel Height="140">
            <Button x:Name="btnClear" DockPanel.Dock="Top" Content="Clear log" HorizontalAlignment="Right" Click="BtnClear_Click" Margin="0,0,0,4" />
            <TextBox x:Name="txtLog" IsReadOnly="True" Text="Nothing yet" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#171B31" Foreground="#86DAC8" Padding="8" TextChanged="TxtLog_TextChanged" />
          </DockPanel>
        </Expander>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label x:Name="lblStatusBar" Padding="0" VerticalContentAlignment="Center">
        <Label.ContentTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </Label.ContentTemplate>
      </Label>
      <Border x:Name="sparklinePanel" Panel.ZIndex="30" Padding="6,2,6,2" CornerRadius="4" Background="#CC121733" BorderBrush="#40FFFFFF" BorderThickness="1" ToolTip="Live history — agents alive (green), top fitness (gold)" Grid.Column="1" Margin="8,0,0,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="alive" Foreground="#FF6FCF8E" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0" />
          <TextBlock Text="fit" Foreground="Gold" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0" />
          <Canvas x:Name="sparkCanvas" Width="120" Height="22" ClipToBounds="True">
            <Polyline x:Name="sparkAlive" Stroke="#FF6FCF8E" StrokeThickness="1.2" />
            <Polyline x:Name="sparkFitness" Stroke="Gold" StrokeThickness="1.2" />
          </Canvas>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
