<Window
    x:Class="AI_Evlo_Test.MovementSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Simulation Settings"
    Height="330"
    Width="430"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="142"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="56"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Rotation HP cost"/>
        <Slider x:Name="sldRotationHpCost" Grid.Row="0" Grid.Column="1" Margin="0,0,8,10" Minimum="0" Maximum="0.2" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged"/>
        <TextBlock x:Name="lblRotationHpCost" Grid.Row="0" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Center" TextAlignment="Right"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Acceleration HP cost"/>
        <Slider x:Name="sldThrustHpCost" Grid.Row="1" Grid.Column="1" Margin="0,0,8,10" Minimum="0" Maximum="0.2" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged"/>
        <TextBlock x:Name="lblThrustHpCost" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Center" TextAlignment="Right"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Landed bird speed"/>
        <Slider x:Name="sldLandedBirdSpeedMultiplier" Grid.Row="2" Grid.Column="1" Margin="0,0,8,10" Minimum="0.05" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged"/>
        <TextBlock x:Name="lblLandedBirdSpeedMultiplier" Grid.Row="2" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Center" TextAlignment="Right"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Bite HP amount"/>
        <Slider x:Name="sldBiteHpAmount" Grid.Row="3" Grid.Column="1" Margin="0,0,8,10" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged"/>
        <TextBlock x:Name="lblBiteHpAmount" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Center" TextAlignment="Right"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Bite cooldown"/>
        <Slider x:Name="sldBiteCooldownTicks" Grid.Row="4" Grid.Column="1" Margin="0,0,8,10" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged"/>
        <TextBlock x:Name="lblBiteCooldownTicks" Grid.Row="4" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Center" TextAlignment="Right"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Bite below HP"/>
        <Slider x:Name="sldPredatorBiteHpThreshold" Grid.Row="5" Grid.Column="1" Margin="0,0,8,10" Minimum="0.1" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SettingsSlider_ValueChanged"/>
        <TextBlock x:Name="lblPredatorBiteHpThreshold" Grid.Row="5" Grid.Column="2" Margin="0,0,0,10" VerticalAlignment="Center" TextAlignment="Right"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="72" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="72" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
