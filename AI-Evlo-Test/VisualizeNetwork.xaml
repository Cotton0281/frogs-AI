<Window x:Class="AI_Evlo_Test.VisualizeNetwork"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AI_Evlo_Test"
        Title="Population Neural Network Designer"
        Width="1220" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#FFF4F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF171B31" Padding="12,10" BorderBrush="#FF29304C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Population" Foreground="#FFB9C2DD" FontSize="11" Margin="2,0,0,3"/>
                    <ComboBox x:Name="populationCombo" Height="28" SelectionChanged="PopulationCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Agent role" Foreground="#FFB9C2DD" FontSize="11" Margin="2,0,0,3"/>
                    <ComboBox x:Name="agentCombo" Height="28" SelectionChanged="AgentCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,12,1">
                    <TextBlock x:Name="agentDetailText" Foreground="#FFD9DEEC" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="growthText" Foreground="#FF8FD5B2" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Right" Margin="0,9,0,0">
                    <Button Content="Refresh" MinWidth="70" Height="28" Margin="0,0,6,0" Click="Refresh_Click"/>
                    <CheckBox x:Name="liveRefreshCheck" Content="Live" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Fit" MinWidth="48" Height="28" Margin="0,0,6,0" Click="Fit_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Mutation Rate" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="mutationRateSlider" Width="110" Minimum="1" Maximum="20" Value="1" IsEnabled="False"
                                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                ValueChanged="MutationRateSlider_ValueChanged" ToolTip="Number of weights or biases changed per mutation event"/>
                        <TextBlock x:Name="mutationRateText" Text="1" Foreground="White" Width="24"
                                   TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="mutateAgentButton" Content="Mutate displayed" MinWidth="106" Height="28" Margin="0,0,6,0"
                            IsEnabled="False" Click="MutateAgent_Click"
                            ToolTip="Mutate the displayed agent using the population mutation rate"/>
                    <Button x:Name="blankNetworkButton" Content="Zero unlocked layers" MinWidth="132" Height="28" Margin="0,0,6,0" IsEnabled="False"
                            Click="BlankNetwork_Click" ToolTip="Set every weight and bias in unlocked layers to zero"/>
                    <Button x:Name="randomizeNetworkButton" Content="Randomize" MinWidth="82" Height="28" Margin="0,0,6,0" IsEnabled="False"
                            Click="RandomizeNetwork_Click" ToolTip="Assign random weights and biases to unlocked layers"/>
                    <Button Content="Add Layer" MinWidth="84" Height="28" Click="AddLayer_Click" Background="#FF3C8D6B" Foreground="White"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <local:NeuralNetworkView x:Name="networkView" Margin="10" LayerLockToggleRequested="NetworkView_LayerLockToggleRequested"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Padding="9,6"
                    CornerRadius="5" Background="#DFFFFFFF" BorderBrush="#FFD1D7E5" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Min |weight|" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF384052"/>
                    <Slider x:Name="weightFilterSlider" Width="120" Minimum="0" Maximum="1" Value="0.03"
                            TickFrequency="0.05" ValueChanged="WeightFilterSlider_ValueChanged"/>
                    <TextBlock x:Name="weightFilterText" Width="42" Text="0.03" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFD6DBE7" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <TextBlock x:Name="statusText" Text="Loading" Foreground="#FF3B4354"/>
                <TextBlock HorizontalAlignment="Right" Text="Wheel: zoom · drag: pan · dashed: residual skip · padlock: protect layer"
                           Foreground="#FF727B90"/>
            </Grid>
        </Border>
    </Grid>
</Window>
